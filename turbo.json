{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["PRISMA_*", "DATABASE_*"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^generate", "^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["generate", "^generate", "^typecheck"]
    },
    "test": {
      "dependsOn": ["generate", "^generate", "^typecheck"]
    },
    "eval": {
      "cache": false
    }
  }
}
