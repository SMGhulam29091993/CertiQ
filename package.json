{
  "name": "certiq",
  "private": true,
  "description": "CertiQ — a certified-metrics analytics agent: answers business questions only from a governed semantic layer, never by guessing.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "turbo run generate",
    "db:migrate": "pnpm --filter @certiq/database migrate",
    "db:migrate:dev": "pnpm --filter @certiq/database migrate:dev",
    "db:status": "pnpm --filter @certiq/database migrate:status",
    "db:drift": "pnpm --filter @certiq/database drift",
    "db:reset": "pnpm --filter @certiq/database reset && pnpm db:seed",
    "db:seed": "pnpm --filter @certiq/database seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:studio": "pnpm --filter @certiq/database studio",
    "eval": "pnpm --filter @certiq/evals eval",
    "eval:fast": "pnpm --filter @certiq/evals eval --fast",
    "eval:baseline": "pnpm --filter @certiq/evals eval:baseline",
    "eval:truth": "pnpm --filter @certiq/evals truth",
    "eval:validate": "pnpm --filter @certiq/evals validate"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "prisma", "@prisma/engines", "@prisma/client"]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
