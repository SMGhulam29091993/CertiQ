# ── LLM ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model per role (see ADR-0002). Fast = analyst tool-calling, Strong = auditor.
CERTIQ_MODEL_FAST=claude-haiku-5-5
CERTIQ_MODEL_STRONG=claude-sonnet-5-5
# USD per million tokens — copy current values from the Anthropic pricing page.
# Left blank on purpose: an invented price the budget guard trusts is worse than none.
CERTIQ_PRICE_FAST_INPUT_PER_MTOK=
CERTIQ_PRICE_FAST_OUTPUT_PER_MTOK=
CERTIQ_PRICE_STRONG_INPUT_PER_MTOK=
CERTIQ_PRICE_STRONG_OUTPUT_PER_MTOK=

# ── Budget guardrails (per question) ──────────────────
CERTIQ_MAX_TOOL_CALLS=4
CERTIQ_MAX_INPUT_TOKENS=40000
CERTIQ_MAX_OUTPUT_TOKENS=4000
CERTIQ_MAX_USD_PER_QUESTION=0.10

# ── Privacy guardrail ─────────────────────────────────
CERTIQ_MIN_GROUP_SIZE=10

# ── Database ──────────────────────────────────────────
# Admin URL is used ONLY by migrate/seed. The API uses the read-only role.
DATABASE_ADMIN_URL=postgres://certiq_admin:certiq_admin@localhost:5433/certiq
DATABASE_READONLY_URL=postgres://certiq_reader:certiq_reader@localhost:5433/certiq
CERTIQ_QUERY_TIMEOUT_MS=3000

# ── Apps ──────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
